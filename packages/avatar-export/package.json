{
  "name": "@awflow/avatar-export",
  "version": "0.0.0",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "awflow-avatar-export": "./bin/awflow-avatar-export.mjs"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "awflow-src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "prepack": "bun scripts/build.ts",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@awflow/avatar": "workspace:^",
    "@resvg/resvg-wasm": "2.6.2",
    "fflate": "0.8.3",
    "gifenc": "1.0.3"
  },
  "devDependencies": {
    "@awflow/typescript-config": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.3",
    "@types/bun": "latest",
    "typescript": "^6.0.2"
  },
  "description": "Rasterise AWFlow avatars to PNG, APNG, GIF and sprite sheets, in Node and the browser.",
  "license": "MIT",
  "author": "AWFlow",
  "homepage": "https://github.com/awflow/avatar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awflow/avatar.git",
    "directory": "packages/avatar-export"
  },
  "keywords": [
    "avatar",
    "png",
    "apng",
    "gif",
    "sprite",
    "deterministic"
  ],
  "publishConfig": {
    "access": "public"
  }
}
