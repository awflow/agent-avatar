{
  "name": "@awflow/avatar",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "development": "./src/adapter.ts",
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js",
      "default": "./dist/adapter.js"
    },
    "./svg": {
      "types": "./dist/svg.d.ts",
      "import": "./dist/svg.js",
      "default": "./dist/svg.js"
    },
    "./compat": {
      "development": "./src/compat.ts",
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.js",
      "default": "./dist/compat.js"
    },
    "./ai": {
      "development": "./src/ai.ts",
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js",
      "default": "./dist/ai.js"
    },
    "./identity": {
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js",
      "default": "./dist/identity.js"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "bench": "bun scripts/bench.ts",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@awflow/typescript-config": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.3",
    "@types/bun": "latest",
    "playwright": "1.64.1",
    "typescript": "^6.0.2"
  },
  "description": "Deterministic SVG avatars from a name, with expressions and a framework-free live mount.",
  "license": "MIT",
  "author": "AWFlow",
  "homepage": "https://github.com/awflow/avatar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awflow/avatar.git",
    "directory": "packages/avatar"
  },
  "keywords": [
    "avatar",
    "svg",
    "deterministic",
    "avatar-library"
  ],
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/test/**",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  }
}
