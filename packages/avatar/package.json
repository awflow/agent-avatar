{
  "name": "@awflow/avatar",
  "version": "1.0.0",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "awflow-avatar": "./bin/awflow-avatar.mjs"
  },
  "exports": {
    ".": {
      "awflow-src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./adapter": {
      "awflow-src": "./src/adapter.ts",
      "types": "./dist/adapter.d.ts",
      "import": "./dist/adapter.js",
      "default": "./dist/adapter.js"
    },
    "./svg": {
      "awflow-src": "./src/svg.ts",
      "types": "./dist/svg.d.ts",
      "import": "./dist/svg.js",
      "default": "./dist/svg.js"
    },
    "./compat": {
      "awflow-src": "./src/compat.ts",
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.js",
      "default": "./dist/compat.js"
    },
    "./ai": {
      "awflow-src": "./src/ai.ts",
      "types": "./dist/ai.d.ts",
      "import": "./dist/ai.js",
      "default": "./dist/ai.js"
    },
    "./identity": {
      "awflow-src": "./src/identity.ts",
      "types": "./dist/identity.d.ts",
      "import": "./dist/identity.js",
      "default": "./dist/identity.js"
    },
    "./cli": {
      "awflow-src": "./bin/cli.mjs",
      "types": "./bin/cli.d.mts",
      "default": "./bin/cli.mjs"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "build": "bun scripts/build.ts",
    "bench": "bun scripts/bench.ts",
    "prepack": "bun run build"
  },
  "devDependencies": {
    "@awflow/typescript-config": "workspace:*",
    "@happy-dom/global-registrator": "^21.0.3",
    "@types/bun": "latest",
    "playwright": "1.64.1",
    "typescript": "^6.0.2"
  },
  "description": "Deterministic SVG avatars from a name, with expressions and a framework-free live mount.",
  "license": "MIT",
  "author": "AWFlow",
  "homepage": "https://github.com/awflow/agent-avatar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/awflow/agent-avatar.git",
    "directory": "packages/avatar"
  },
  "keywords": [
    "avatar",
    "svg",
    "deterministic",
    "avatar-library"
  ],
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@awflow/avatar-export": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@awflow/avatar-export": {
      "optional": true
    }
  }
}
